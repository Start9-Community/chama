# --- Public identity -------------------------------------------------------
# The public domain you serve LNURL from. Wallets REQUIRE https in clearnet.
# No scheme, no trailing slash. This is the right-hand side of the address:
#   <username>@LNURL_HOSTNAME
LNURL_HOSTNAME=pay.chapsmart.com

# Port this server listens on (put a reverse proxy / TLS in front).
PORT=8000

# --- phoenixd connection ---------------------------------------------------
# phoenixd exposes its HTTP API on 127.0.0.1:9740 by default and uses HTTP
# Basic auth where the PASSWORD is the `http-password` from ~/.phoenix/phoenix.conf
# (the username is ignored; "_" is conventional).
#
# Option A: embed the password in the URL (same convention as phoenixd-lnurl):
PHOENIXD_URL=http://_:CHANGE_ME_HTTP_PASSWORD@127.0.0.1:9740
#
# Option B: keep them separate:
# PHOENIXD_URL=http://127.0.0.1:9740
# PHOENIXD_HTTP_PASSWORD=CHANGE_ME_HTTP_PASSWORD
#
# Tip: phoenixd also has `http-password-limited-access`. Creating invoices and
# checking incoming payments works with the limited password — prefer it here.

# --- Amount bounds (satoshis) ---------------------------------------------
MIN_SENDABLE_SAT=1
MAX_SENDABLE_SAT=1000000

# --- LUD-12 comments -------------------------------------------------------
# Max comment length a payer may attach. Set 0 to disable comments entirely.
COMMENT_ALLOWED=280

# --- Username policy -------------------------------------------------------
# Comma-separated lowercase allowlist, e.g. "alice,bob,treasury".
# Leave EMPTY to accept any valid username.
# IMPORTANT: every username resolves to the SAME phoenixd wallet (funds pool).
# Use ALLOWED_USERNAMES + your own ledger (keyed on externalId) to attribute
# who a payment was for. See README "Custodial model".
ALLOWED_USERNAMES=

# Optional message the payer's wallet shows after a successful payment (LUD-09).
SUCCESS_MESSAGE=Payment received — thank you!
