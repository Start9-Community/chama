{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chama",
  "version": "2.3.0",
  "identifier": "app.chama.market",
  "build": {
    "beforeDevCommand": "npm run tauri:sidecar && npm run dev",
    "beforeBuildCommand": "npm run tauri:sidecar && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chama",
        "label": "main",
        "width": 430,
        "height": 860,
        "minWidth": 390,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "externalBin": [
      "binaries/chama-fedimint-bridge"
    ],
    "icon": [
      "../public/icons/favicon-32x32.png",
      "../public/icons/favicon-128x128.png",
      "../public/icons/favicon-256x256.png",
      "../public/icons/favicon-512x512.png",
      "../public/icons/favicon.ico"
    ]
  }
}
