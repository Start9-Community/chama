# ./migration/.gitignore — keep secrets OUT of git.
# Anything sensitive lives in this tree and must never be committed.

# StartTunnel web UI access (URL, password, Root CA)
start-tunnel-access.md

# API tokens / keys / secrets / env
*.token
*token*
secrets/
.env
*.env
*.key
*.pem

# WireGuard live configs (contain private keys) — but keep the *.example templates
wg0.conf
*-private.conf
configs/wg0.conf
configs/*.live.conf

# Database dumps & raw backups (entire backup tree, except the placeholder)
backup/*
!backup/.gitkeep

# DB dump artifacts anywhere
*.sql
*.sql.gz
*.dump
*.dump.gz
