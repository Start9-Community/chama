# Append this block to /etc/caddy/Caddyfile on the IncogNET box
# (satoshi owns it 640 → no sudo). Apply with:  caddy reload --config /etc/caddy/Caddyfile
# Caddy auto-provisions the LE cert (global ACME email already set) once
# relay.chama.community resolves to this box, and upgrades WebSockets in
# reverse_proxy transparently — no extra config needed.

relay.chama.community {
	reverse_proxy 127.0.0.1:7777

	header {
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/relay-access.log {
			roll_size 10mb
			roll_keep 3
		}
		format json
	}
}
